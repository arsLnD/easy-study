# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (уже добавлен в .gitignore).

ENVIRONMENT=development

# Строка подключения к PostgreSQL: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://plans_user:plans_password@localhost:5432/plans_finance

# Сгенерируйте свой секрет, например: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Список разрешённых источников для CORS, через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
