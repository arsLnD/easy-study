# Скопируйте в .env для локальной разработки при необходимости.
# Если не задано — используется относительный путь /api (через Vite-прокси в dev,
# см. vite.config.ts). В продакшне укажите полный адрес вашего backend, например:
# VITE_API_BASE_URL=https://api.plans-finance.example.com/api
VITE_API_BASE_URL=
