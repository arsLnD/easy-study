{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/ai-structure", "destination": "/api/ai-structure" },
    { "source": "/api/:path*", "destination": "https://plans-finance-backend.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
